# Copy this file to .env and add your TypeSafe key locally.
# Never commit .env or paste the key into an issue or chat.
TYPESAFE_API_KEY=

# Off by default. Set to 1 to save each classifier request/answer under .local/capture/
# for later fine-tuning (e.g. Kev). See docs/local-capture.md before turning this on.
JAO_CAPTURE=
